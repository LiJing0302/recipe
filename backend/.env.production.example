# Fill these values in 1Panel instead of committing a production .env file.
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database>?schema=public"
PORT=3000
SHARE_SECRET="replace-with-a-long-random-share-secret"
MINIO_ENDPOINT="https://s3.wenjun.cc.cd"
MINIO_ACCESS_KEY="recipe-backend"
MINIO_SECRET_KEY="replace-with-your-secret-key"
MINIO_BUCKET="recipe-images"
MINIO_REGION="us-east-1"
MINIO_FORCE_PATH_STYLE="true"
PUBLIC_API_BASE_URL="https://api.wenjun.cc.cd"
