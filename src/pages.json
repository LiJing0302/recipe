{
  "pages": [
    {
      "path": "pages/index/index",
      "style": { "navigationStyle": "custom" }
    },
    {
      "path": "pages/community/index",
      "style": { "navigationStyle": "custom" }
    },
    {
      "path": "pages/tabbar-placeholder/index",
      "style": { "navigationStyle": "custom" }
    }
  ],
  "subPackages": [
    {
      "root": "pages-sub",
      "pages": [
        {
          "path": "ingredients/storage",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "ingredients/categories",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "shared-recipes/index",
          "style": { "navigationStyle": "custom" }
        },
        { "path": "index/index", "style": { "navigationStyle": "custom" } },
        {
          "path": "recipe/detail",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "recipe/edit",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "scan/index",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "cook/index",
          "style": { "navigationStyle": "custom" }
        },
        {
          "path": "database/schema",
          "style": { "navigationStyle": "custom" }
        }
      ]
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "食光 AI",
    "navigationBarBackgroundColor": "#FDF8F2",
    "backgroundColor": "#FDF8F2",
    "backgroundTextStyle": "light",
    "app-plus": {
      "bounce": "none"
    }
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  }
}
